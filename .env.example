DISCORD_TOKEN=PUT_YOUR_NEW_DISCORD_TOKEN_HERE
GUILD_ID=
AUTO_FETCH=true
# Same composite profile card for boys/girls and anime. Use source for original Unsplash hotlinks.
PHOTO_DISPLAY=card
# Image-only messages by default. Unsplash API requires displayed attribution; set true for it.
# PC wallpapers always remain one original attachment without caption/page link, even when true.
SHOW_IMAGE_CREDITS=false
IMAGE_FETCH_INTERVAL_MINUTES=80
TZ=Asia/Riyadh

# Unsplash: Access Key only (not Secret Key). https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Fanart.tv: matching poster/background from one movie.
# Get an API/project key: https://fanart.tv/get-an-api-key/
FANART_API_KEY=
# IMDb movie IDs; this list does not verify Netflix availability.
FANART_MOVIE_IDS=tt1375666,tt0816692,tt0468569,tt0133093,tt1856101,tt1160419,tt15239678

# Wallhaven official API: paired anime cards; PC games/anime original files only.
# PC: strict SFW detail/tag checks, >=1920x1080, JPEG/PNG/WebP <=8 MiB, no resizing.
# Public SFW search needs no key. PC sends/downloads refetch the original from the source.
WALLHAVEN_ENABLED=true
WALLHAVEN_API_KEY=

# Optional overrides; leave blank for automatic monochrome button icons.
DOWNLOAD_EMOJI_ID=
EDIT_EMOJI_ID=
DELETE_EMOJI_ID=
